# ==========================================
# VeloProve Comprehensive Git Ignore Configuration
# ==========================================

# 1. Dependency Directories
node_modules/
jspm_packages/
.pnp
.pnp.js

# 2. Build & Distribution Outputs (Compiled artifacts)
dist/
build/
out/
.next/
.nuxt/
.output/
.turbo/
.prompt/

# 3. Test Coverage & Diagnostic Reports
coverage/
.nyc_output/
*.lcov
reports/
mochawesome-report/
test-results/
playwright-report/
blob-report/

# 4. VeloProve Local Runtime State & Snapshots
.veloprove/
.veloprove-cache/
*.db.snapshot
*.sqlite.bak

# 5. Package Tarballs & Archives
*.tgz
*.tar.gz
*.zip

# 6. Environment Variables, API Keys & Secrets
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# 7. IDE, Editor & Tool State
.cursor/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# 8. OS System Files & Caches
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 9. Logs & Runtime Dumps
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.pid
*.seed
*.pid.lock

# 10. TypeScript & Build Cache
*.tsbuildinfo
.eslintcache
.stylelintcache

# 11. Local clean-room / one-off consumer installs
_e2e_consumer/

# 12. Ephemeral lint fixture (created by unit tests)
fixtures/lint-test-project/

# 13. Smoke-generated plans under fixtures (keep fixture source; ignore plan spam)
fixtures/**/.veloprove/plans/plan-*.json
fixtures/**/tests/fixtures/
fixtures/**/tests/unit/tc-*.test.js

# 14. Local-only marketplace demo (never ship to git/npm)
_local_demo/

# 15. Smoke-generated HTML reports under fixtures
fixtures/**/veloprove-executive-report.html
